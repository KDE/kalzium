						 <listitem
><para
><action
>افتح</action
> <link linkend="perf_calculation"
>حوار <guilabel
>نفّذ عملية حسابية</guilabel
></link
>.</para
></listitem>
					 </varlistentry>
					 <varlistentry>
						 <term
><menuchoice
><guimenu
